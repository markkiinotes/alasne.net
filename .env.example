# Alasne environment template
#
# Copy this file to .env for local development, then replace placeholder
# values as needed. Never commit a real .env file or real credentials.
# See PRODUCTION-DEPLOYMENT.md before configuring a public host.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Alasne Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://alasne.net.local
APP_TIMEZONE=America/New_York
APP_KEY=replace-with-a-long-random-secret-value

# -----------------------------------------------------------------------------
# Session / HTTPS / proxy
# -----------------------------------------------------------------------------
SESSION_NAME=ALASNESESSID
SESSION_SAMESITE=Lax

# Leave SESSION_SECURE unset locally so Alasne can derive it from HTTPS.
# For production HTTPS you may explicitly set:
# SESSION_SECURE=true

# Enable only when the application is reachable exclusively through a trusted
# reverse proxy/load balancer that sets X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY_HEADERS=false

# HSTS is emitted only when APP_ENV=production and the request is HTTPS.
HSTS_ENABLED=true
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alasne
DB_USERNAME=alasne
DB_PASSWORD=replace-with-database-password

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Put real values only in .env / your production secret store. Never commit
# secret keys or webhook signing secrets.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email outbox / queue
# -----------------------------------------------------------------------------
# Supported Mission Control queue transports: log, smtp, php_mail
# Keep log during local development so messages are not delivered externally.
EMAIL_QUEUE_TRANSPORT=log
EMAIL_QUEUE_PROCESSING_TIMEOUT_MINUTES=30
MAIL_BATCH_SIZE=10
MAIL_MAX_ATTEMPTS=3

# PHPMailer-compatible MAIL_* settings used by the storefront email outbox.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Alasne"

# MAIL_FROM is also used by Mission Control / php_mail transport.
# In production it normally matches MAIL_FROM_ADDRESS.
MAIL_FROM=

# Optional Mission Control SMTP aliases. When present, SMTP_* takes precedence
# in MissionControlSmtpMailService; otherwise MAIL_* values are used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# Carrier integration defaults
# -----------------------------------------------------------------------------
# Mission Control's default EasyPost integration references these names.
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Supplier integrations
# -----------------------------------------------------------------------------
# Supplier integrations store the names of their credential environment
# variables in the database (api_key_env, api_secret_env, account_id_env).
# Define those exact names on the production host when an integration is live.
# Example placeholders only:
# SUPPLIER_EXAMPLE_API_KEY=
# SUPPLIER_EXAMPLE_API_SECRET=
# SUPPLIER_EXAMPLE_ACCOUNT_ID=
